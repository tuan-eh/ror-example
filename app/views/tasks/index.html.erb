<h1>My TODO List</h1>

<div style="margin-bottom: 20px;">
  <%= link_to "← Back to Projects", root_path %>
  <h2>Tasks for <%= @project.name %></h2>
</div>

<%= form_with model: [@project, @task], local: true do |form| %>
  <div>
    <%= form.text_field :title, placeholder: "New task..." %>
    <%= form.submit "Add Task" %>
  </div>
<% end %>

<hr>

<ul>
 <% @tasks.each do |task| %>
    <li class="task-item">
      <span class="task-title">
        <% if task.project %>
          <%= link_to task.project.name, project_path(task.project), 
                      style: "background: #e2e8f0; padding: 2px 6px; border-radius: 4px; margin-right: 8px; text-decoration: none; color: #334155;" %>
        <% else %>
          <small style="background: #e2e8f0; padding: 2px 6px; border-radius: 4px; margin-right: 8px; color: #334155;">
            Inbox
          </small>
        <% end %>
        <% if task.completed? %>
          <del><%= task.title %></del>
        <% else %>
          <strong><%= task.title %></strong>
        <% end %>
      </span>

      <div class="task-actions">
        <%= button_to task.completed? ? "Mark Undone" : "Mark Done", 
                      task_path(task), method: :patch, 
                      params: { task: { completed: !task.completed } } %>
        
        <%= link_to "Edit Name", edit_task_path(task) %>

        <%= button_to "Delete", task_path(task), method: :delete %>
      </div>
    </li>
  <% end %>
</ul>