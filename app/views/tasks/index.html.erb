<h1>My TODO List</h1>

<%= form_with model: @task, local: true do |form| %>
  <div>
    <%= form.text_field :title, placeholder: "What needs to be done?" %>
    <%= form.submit "Add Task" %>
  </div>
<% end %>

<hr>

<ul>
    <% @tasks.each do |task| %>
        <li>
            <% if task.completed? %>
                <del><%= task.title %></del>
            <% else %>
                <strong><%= task.title %></strong>
            <% end %>

            <%= button_to task.completed? ? "Mark Undone" : "Mark Done", task_path(task), method: :patch %>
            
            <%= button_to "Delete", task_path(task), method: :delete %>
        </li>
    <% end %>
</ul>