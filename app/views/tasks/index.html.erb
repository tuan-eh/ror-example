<h1>My TODO List</h1>

<%= form_with model: @task, local: true do |form| %>
  <div>
    <%= form.text_field :title, placeholder: "What needs to be done?" %>
    <%= form.submit "Add Task" %>
  </div>
<% end %>

<hr>

<ul>
 <% @tasks.each do |task| %>
    <li class="task-item">
      <span class="task-title">
        <% if task.completed? %>
          <del><%= task.title %></del>
        <% else %>
          <strong><%= task.title %></strong>
        <% end %>
      </span>

      <div class="task-actions">
        <%= button_to task.completed? ? "Mark Undone" : "Mark Done", 
                      task_path(task), method: :patch, 
                      params: { task: { completed: !task.completed } } %>
        
        <%= link_to "Edit Name", edit_task_path(task) %>

        <%= button_to "Delete", task_path(task), method: :delete %>
      </div>
    </li>
  <% end %>
</ul>